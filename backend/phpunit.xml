<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:lynMQbjwAfPGpeMgbpWGMZm/AfUZ/dzHlRpktHAT0ow="/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- Checkpoint 6 — Supabase MFA coexistence. HS256 shared-secret
             values only, so SupabaseTokenValidator's fallback verification
             path is testable without network access to a real JWKS
             endpoint (see SupabaseMfaTest). Not real credentials. -->
        <env name="SUPABASE_URL" value="https://test-project.supabase.co"/>
        <env name="SUPABASE_JWT_SECRET" value="test-only-shared-secret-not-a-real-credential"/>
        <!-- Not a real credential. MFA enforcement (EnsureSupabaseAal2)
             refuses to evaluate without a service-role key, so its tests
             need one present; every test that reaches the Admin API fakes
             the HTTP call itself (see MfaEnforcementTest), so this value is
             never sent anywhere. -->
        <env name="SUPABASE_SERVICE_ROLE_KEY" value="test-only-service-role-key-not-a-real-credential"/>
    </php>
</phpunit>
