APP_NAME="BADAC CDARS API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database (PostgreSQL / Supabase) ---
# Local Postgres example:
#   DB_HOST=127.0.0.1
#   DB_PORT=5432
#   DB_DATABASE=badac_cdars
#   DB_USERNAME=postgres
#   DB_PASSWORD=your_local_password
#
# Supabase example (get these from Project Settings -> Database):
#   DB_HOST=db.xxxxxxxxxxxx.supabase.co
#   DB_PORT=5432
#   DB_DATABASE=postgres
#   DB_USERNAME=postgres
#   DB_PASSWORD=your_supabase_db_password
#   DB_SSLMODE=require
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=badac_cdars
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

# --- CORS / Sessions ---
# Final auth migration — this API is stateless (Bearer Supabase JWTs only).
# There is no more SANCTUM_STATEFUL_DOMAINS (the laravel/sanctum package
# has been removed — see AUTH_MIGRATION_STATUS.md) and no cross-origin
# session cookie for CORS to allow credentials for (see config/cors.php).
# SESSION_* below is left at Laravel's own defaults purely for whatever
# internal framework use (e.g. `session()` flash data in a future feature)
# might need it — it is not part of authentication.
CORS_ALLOWED_ORIGINS=http://localhost:5173
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=sync

# --- Supabase Auth (the ONLY authentication system this application has —
# see AUTH_MIGRATION_STATUS.md). Read by config/supabase.php /
# App\Services\SupabaseTokenValidator, which verifies every incoming
# request's Bearer token before UserController/IncidentController/etc. ever
# run (see the 'auth:supabase' middleware in routes/api.php).
#
# Get SUPABASE_URL and SUPABASE_PROJECT_ID from Project Settings -> API.
# SUPABASE_JWT_SECRET (Project Settings -> API -> JWT Secret) is only a
# fallback for legacy HS256 projects — leave blank if your project uses the
# current JWKS-based signing keys, which need no secret here at all.
SUPABASE_URL=
SUPABASE_PROJECT_ID=
SUPABASE_JWT_SECRET=

# SUPABASE_SERVICE_ROLE_KEY — Project Settings -> API -> service_role
# secret. Used ONLY by App\Services\SupabaseAdminService, ONLY to let an
# Administrator remove another user's Supabase MFA factor from
# User Management (the "lost my phone" break-glass action — see
# UserController::disableTwoFactor). This is a highly privileged key:
#   - NEVER put it in the frontend's .env or in any VITE_* variable.
#   - NEVER commit a real value here.
#   - NEVER log it, return it in an API response, or pass it to any
#     third-party service.
# Leaving this blank does not break sign-in, MFA enrollment, or self-service
# MFA removal (all of that happens directly against Supabase from the
# frontend) — it only disables the admin-forced-removal action, which will
# return a 502 with a clear message until this is set.
SUPABASE_SERVICE_ROLE_KEY=

# Google sign-in is Supabase's own OAuth provider (configured in the
# Supabase Dashboard -> Authentication -> Providers -> Google, and in
# Google Cloud Console — see the frontend's .env.example for the exact
# redirect URI Supabase needs there). This backend has no Google client
# secret and no OAuth callback route of its own.

# --- Mail ---
# Not currently used by any authentication flow — Supabase Auth sends its
# own password-reset and email-confirmation emails directly (configured in
# the Supabase Dashboard -> Authentication -> Email Templates), not through
# this backend. Left here for any future feature that needs to send mail
# from the Laravel side. Defaults to the `log` driver (writes to
# storage/logs/laravel.log instead of actually sending).
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@barangay178.gov.ph"
MAIL_FROM_NAME="BADAC Analytics"
