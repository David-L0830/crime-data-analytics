# Base URL of the Laravel API (see backend/.env APP_URL -- this should be
# that same host with /api appended).
VITE_API_URL=http://localhost:8000/api

# Supabase Auth — the ONLY authentication system this application has (see
# AUTH_MIGRATION_STATUS.md). Required for the app to be usable at all: with
# these unset, the Login page cannot authenticate anyone (see
# src/lib/supabaseClient.js's isSupabaseConfigured, and Login.jsx / AuthContext.jsx).
#
# Get these from Project Settings -> API Keys in the Supabase Dashboard.
# Only the publishable (public) key belongs here — NEVER put the secret /
# service-role key in this file or anywhere in frontend code (it is used
# only by the backend's App\Services\SupabaseAdminService — see
# backend/.env.example).
#
# This project's legacy JWT-based anon key was permanently disabled when
# Supabase JWT signing keys were adopted; use the sb_publishable_... key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# "Continue with Google" (src/context/AuthContext.jsx's loginWithGoogle)
# reuses the two values above — no separate frontend variable is required.
# Two things must be configured OUTSIDE this repo before it will work,
# neither of which is a secret that belongs in frontend code:
#   1. In the Supabase Dashboard: Authentication -> Providers -> Google —
#      enable it and supply a Google OAuth Client ID/Secret from Google
#      Cloud Console. The client secret is entered into Supabase's
#      dashboard, never into this app.
#   2. In Google Cloud Console, on that OAuth client's "Authorized redirect
#      URIs", add: https://<your-project-ref>.supabase.co/auth/v1/callback
# Authentication -> URL Configuration -> Redirect URLs in the Supabase
# Dashboard must also allow this app's /login and /reset-password URLs
# (e.g. http://localhost:5173/login for local dev), since those are what
# AuthContext.loginWithGoogle and ForgotPassword.jsx pass as redirectTo.
